rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =======================================================
    // 1. FUNCIONES DE AUTENTICACIÓN Y ROLES
    // =======================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Obtiene los datos del perfil de usuario de forma 100% segura.
    // Si no está autenticado, retorna inmediatamente {} para evitar evaluar rutas o tokens nulos.
    function getUserData() {
      return !isAuthenticated()
        ? {}
        : (request.auth.token.email != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email)))
          ? get(/databases/$(database)/documents/users/$(request.auth.token.email)).data
          : (request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            : {};
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email == 'fantoniocastronunez@gmail.com') ||
        ('role' in getUserData() && getUserData().role == 'superadmin') ||
        ('roles' in getUserData() && getUserData().roles is map && 'global' in getUserData().roles && getUserData().roles.global == 'superadmin')
      );
    }
    
    function isCourseAdmin(courseId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          courseId != null &&
          'roles' in getUserData() && 
          getUserData().roles is map &&
          courseId in getUserData().roles && 
          (getUserData().roles[courseId] == 'tesorero' || getUserData().roles[courseId] == 'admin' || getUserData().roles[courseId] == 'presidente')
        )
      );
    }

    // Permite que cualquier dispositivo que escanee el QR de comandas o despacho actualice únicamente
    // los campos operativos de cocina, controlando tipos y longitud para prevenir abusos.
    function isAllowedKitchenStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'orderStatus', 'kitchenStatus', 'kitchenNotes', 'preparedAt', 'deliveredAt', 'status', 'deliveredBy', 'updatedAt'
      ]) &&
      (!('orderStatus' in request.resource.data) || (request.resource.data.orderStatus is string && request.resource.data.orderStatus.size() <= 50)) &&
      (!('kitchenStatus' in request.resource.data) || (request.resource.data.kitchenStatus is string && request.resource.data.kitchenStatus.size() <= 50)) &&
      (!('status' in request.resource.data) || (request.resource.data.status is string && request.resource.data.status.size() <= 50)) &&
      (!('kitchenNotes' in request.resource.data) || (request.resource.data.kitchenNotes is string && request.resource.data.kitchenNotes.size() <= 1000)) &&
      (!('deliveredBy' in request.resource.data) || (request.resource.data.deliveredBy is string && request.resource.data.deliveredBy.size() <= 200)) &&
      (!('preparedAt' in request.resource.data) || (request.resource.data.preparedAt is string && request.resource.data.preparedAt.size() <= 100) || request.resource.data.preparedAt is timestamp) &&
      (!('deliveredAt' in request.resource.data) || (request.resource.data.deliveredAt is string && request.resource.data.deliveredAt.size() <= 100) || request.resource.data.deliveredAt is timestamp) &&
      (!('updatedAt' in request.resource.data) || (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 100) || request.resource.data.updatedAt is timestamp);
    }

    // =======================================================
    // 2. REGLAS POR COLECCIÓN
    // =======================================================

    // -- USERS --
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Permitir crear su propio perfil, o permitir que un admin pre-registre a un apoderado
      allow create: if isAuthenticated() && (
        (request.auth.token.email == userId || request.auth.uid == userId) ||
        isSuperAdmin() ||
        ('roles' in getUserData() && getUserData().roles is map && getUserData().roles.values().hasAny(['admin', 'tesorero']))
      );
      // Permitir actualización: 
      // 1. Un superadmin puede actualizar a cualquiera.
      // 2. Un usuario puede actualizar sus propios datos. Si modifica sus roles (para unirse a un curso),
      //    solo puede hacerlo si no se está asignando permisos de admin/tesorero/superadmin.
      //    Si ya tenía esos permisos, se le permite modificar su propio perfil.
      // 3. Un admin/tesorero de algún curso puede modificar roles de otros (confianza delegada).
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (request.auth.token.email == userId || request.auth.uid == userId) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles']) ||
            (
              (!('roles' in request.resource.data) || !request.resource.data.roles.values().hasAny(['admin', 'tesorero', 'superadmin']))
            ) ||
            (
              'roles' in resource.data && resource.data.roles.values().hasAny(['admin', 'tesorero', 'superadmin'])
            )
          )
        ) ||
        ('roles' in getUserData() && getUserData().roles is map && getUserData().roles.values().hasAny(['admin', 'tesorero']))
      );
      
      allow delete: if isSuperAdmin();
    }
    
    // -- STUDENTS --
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
      
      // Apoderados pueden vincularse a sí mismos a un estudiante (solo tocan campos apoderadoEmails/rut)
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apoderadoEmails', 'apoderadoEmail', 'rut'])
      );
    }
    
    // -- DEBTS (DEUDAS) --
    match /debts/{debtId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
      
      // Apoderados pueden actualizar SOLO deudas donde estén vinculados (para subir comprobantes)
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        (request.auth.token.email != null && 'apoderadoEmails' in resource.data && resource.data.apoderadoEmails is list && request.auth.token.email in resource.data.apoderadoEmails) ||
        (request.auth.token.email != null && 'apoderadoEmail' in resource.data && request.auth.token.email == resource.data.apoderadoEmail)
      );
    }
    
    // -- EXPENSES, FUNDS, TRANSACTIONS, OUTCOMES (FINANZAS NÚCLEO) --
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }
    
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }
    
    match /funds/{fundId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }
    
    match /transactions/{txId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }
    
    match /fund_transfers/{transferId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }
    
    match /outcomes/{outcomeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        (('eventId' in request.resource.data || 'fundId' in request.resource.data) && (
          isSuperAdmin() ||
          ('roles' in getUserData()) ||
          ('role' in getUserData() && getUserData().role != null)
        ))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        (('eventId' in resource.data || 'fundId' in resource.data || 'eventId' in request.resource.data || 'fundId' in request.resource.data) && (
          isSuperAdmin() ||
          ('roles' in getUserData()) ||
          ('role' in getUserData() && getUserData().role != null)
        ))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        (('eventId' in resource.data || 'fundId' in resource.data) && (
          isSuperAdmin() ||
          ('roles' in getUserData()) ||
          ('role' in getUserData() && getUserData().role != null)
        ))
      );
    }
    
    match /incomes/{incomeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        (('eventId' in request.resource.data || 'fundId' in request.resource.data) && (
          isSuperAdmin() ||
          ('roles' in getUserData()) ||
          ('role' in getUserData() && getUserData().role != null)
        ))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        (('eventId' in resource.data || 'fundId' in resource.data || 'eventId' in request.resource.data || 'fundId' in request.resource.data) && (
          isSuperAdmin() ||
          ('roles' in getUserData()) ||
          ('role' in getUserData() && getUserData().role != null)
        ))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        (('eventId' in resource.data || 'fundId' in resource.data) && (
          isSuperAdmin() ||
          ('roles' in getUserData()) ||
          ('role' in getUserData() && getUserData().role != null)
        ))
      );
    }
    
    // -- APPROVALS (SISTEMA DE APROBACIONES) --
    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); 
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }
    
    match /pending_actions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); 
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }
    
    // -- EVENTS, EVENT ITEMS, EVENT SALES, TICKETS (PUNTO DE VENTA Y EVENTOS) --
    match /events/{eventId} {
      // Lectura pública total (get individual y list/queries) para que clientes y personal
      // consulten los datos del evento vía enlace o código QR sin requerir autenticación
      allow read: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId))
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId))
      );
    }

    match /eventItems/{itemId} {
      // Lectura pública total (get individual y list/queries) para visualización de catálogo,
      // menú y productos en vistas públicas de clientes, pedidos o comandas
      allow read: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
    }

    match /eventInventory/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
    }

    match /eventSales/{saleId} {
      // Lectura pública total (get individual y list/queries) para que:
      // 1. Clientes consulten el estado de su pedido en tiempo real (/pedido/:saleId)
      // 2. Personal y pantallas de cocina listen las comandas del evento (/comandas/:eventId)
      // 3. Clientes o personal verifiquen la entrega por QR (/entrega/:saleId)
      // Todo ello sin requerir inicio de sesión ni arrojar 'Missing or insufficient permissions'.
      allow read: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      // Actualización permitida a administradores del curso/evento, o a cualquier dispositivo vía QR
      // que actualice exclusivamente campos operativos de cocina y despacho (orderStatus, kitchenStatus, etc.)
      allow update: if (
        isAuthenticated() && (
          isSuperAdmin() ||
          ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
          ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
          ('roles' in getUserData()) ||
          ('role' in getUserData() && getUserData().role != null)
        )
      ) || isAllowedKitchenStatusUpdate();
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
    }

    match /eventPettyCash/{pettyCashId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
    }
    
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
    }
    
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
    }
    
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData()) ||
        ('role' in getUserData() && getUserData().role != null)
      );
    }

    // -- MAIL (SISTEMA DE NOTIFICACIONES EXTENSION) --
    match /mail/{mailId} {
      // Cualquier usuario autenticado puede desencadenar un envío de correo (ej. recibo de pago o notificación)
      allow create: if isAuthenticated();
      allow read, update, delete: if false; // Solo el backend/extension de Firebase puede leer y modificar la cola
    }
    
    // -- COURSES --
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }
    
    // -- SETTINGS --
    match /settings/{settingId} {
      // Permite lectura pública de 'version' para VersionChecker en cualquier vista (pública o autenticada)
      allow read: if settingId == 'version' || isAuthenticated();
      // Permite actualizar configuraciones al superadmin o al admin del curso correspondiente
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        isCourseAdmin(settingId)
      );
      allow delete: if isSuperAdmin();
    }
    
  }
}
