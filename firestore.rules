rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =======================================================
    // 1. FUNCIONES DE AUTENTICACIÓN Y ROLES
    // =======================================================
    
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }
    
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        ? get(/databases/$(database)/documents/users/$(request.auth.token.email)).data
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          : {});
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'superadmin';
    }
    
    function isCourseAdmin(courseId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          courseId != null &&
          'roles' in getUserData() && 
          courseId in getUserData().roles && 
          (getUserData().roles[courseId] == 'tesorero' || getUserData().roles[courseId] == 'admin')
        )
      );
    }

    // =======================================================
    // 2. REGLAS POR COLECCIÓN
    // =======================================================

    // -- USERS --
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Permitir crear su propio perfil, o permitir que un admin pre-registre a un apoderado
      allow create: if isAuthenticated() && (
        (request.auth.token.email == userId || request.auth.uid == userId) ||
        isSuperAdmin() ||
        ('roles' in getUserData() && getUserData().roles.values().hasAny(['admin', 'tesorero']))
      );
      // Permitir actualización: 
      // 1. Un superadmin puede actualizar a cualquiera.
      // 2. Un usuario puede actualizar sus propios datos. Si modifica sus roles (para unirse a un curso),
      //    solo puede hacerlo si no se está asignando permisos de admin/tesorero/superadmin.
      //    Si ya tenía esos permisos, se le permite modificar su propio perfil.
      // 3. Un admin/tesorero de algún curso puede modificar roles de otros (confianza delegada).
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (request.auth.token.email == userId || request.auth.uid == userId) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles']) ||
            (
              (!('roles' in request.resource.data) || !request.resource.data.roles.values().hasAny(['admin', 'tesorero', 'superadmin']))
            ) ||
            (
              'roles' in resource.data && resource.data.roles.values().hasAny(['admin', 'tesorero', 'superadmin'])
            )
          )
        ) ||
        ('roles' in getUserData() && getUserData().roles.values().hasAny(['admin', 'tesorero']))
      );
      
      allow delete: if isSuperAdmin();
    }
    
    // -- STUDENTS --
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseAdmin(request.resource.data.courseId);
      allow delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
      
      // Apoderados pueden vincularse a sí mismos a un estudiante (solo tocan campos apoderadoEmails/rut)
      allow update: if isAuthenticated() && (
        isCourseAdmin(resource.data.courseId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apoderadoEmails', 'apoderadoEmail', 'rut'])
      );
    }
    
    // -- DEBTS (DEUDAS) --
    match /debts/{debtId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseAdmin(request.resource.data.courseId);
      allow delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
      
      // Apoderados pueden actualizar SOLO deudas donde estén vinculados (para subir comprobantes)
      allow update: if isAuthenticated() && (
        isCourseAdmin(resource.data.courseId) ||
        (request.auth.token.email in resource.data.apoderadoEmails) ||
        (request.auth.token.email == resource.data.apoderadoEmail)
      );
    }
    
    // -- EXPENSES, FUNDS, TRANSACTIONS, OUTCOMES (FINANZAS NÚCLEO) --
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }
    
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseAdmin(request.resource.data.courseId);
      allow update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }
    
    match /funds/{fundId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseAdmin(request.resource.data.courseId);
      allow update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }
    
    match /transactions/{txId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseAdmin(request.resource.data.courseId);
      allow update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }
    
    match /fund_transfers/{transferId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseAdmin(request.resource.data.courseId);
      allow update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }
    
    match /outcomes/{outcomeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('eventId' in request.resource.data && ('roles' in getUserData()))
      );
      allow update, delete: if isAuthenticated() && (
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('eventId' in resource.data && ('roles' in getUserData()))
      );
    }
    
    match /incomes/{incomeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        ('courseId' in request.resource.data && isCourseAdmin(request.resource.data.courseId)) ||
        ('eventId' in request.resource.data && ('roles' in getUserData()))
      );
      allow update, delete: if isAuthenticated() && (
        ('courseId' in resource.data && isCourseAdmin(resource.data.courseId)) ||
        ('eventId' in resource.data && ('roles' in getUserData()))
      );
    }
    
    // -- APPROVALS (SISTEMA DE APROBACIONES) --
    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); 
      allow update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }
    
    match /pending_actions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); 
      allow update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }
    
    // -- EVENTS, EVENT ITEMS, EVENT SALES, TICKETS (PUNTO DE VENTA) --
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseAdmin(request.resource.data.courseId);
      allow update, delete: if isAuthenticated() && isCourseAdmin(resource.data.courseId);
    }

    match /eventItems/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData() && getUserData().roles.values().hasAny(['admin', 'tesorero'])) ||
        ('role' in getUserData() && (getUserData().role == 'superadmin' || getUserData().role == 'admin' || getUserData().role == 'tesorero'))
      );
    }

    match /eventInventory/{itemId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData() && getUserData().roles.values().hasAny(['admin', 'tesorero'])) ||
        ('role' in getUserData() && (getUserData().role == 'superadmin' || getUserData().role == 'admin' || getUserData().role == 'tesorero'))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData() && getUserData().roles.values().hasAny(['admin', 'tesorero', 'apoderado'])) ||
        ('role' in getUserData() && (getUserData().role == 'superadmin' || getUserData().role == 'admin' || getUserData().role == 'tesorero' || getUserData().role == 'apoderado'))
      );
    }

    match /eventSales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData() && getUserData().roles.values().hasAny(['admin', 'tesorero', 'apoderado'])) ||
        ('role' in getUserData() && getUserData().role != null)
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        ('roles' in getUserData() && getUserData().roles.values().hasAny(['admin', 'tesorero'])) ||
        ('role' in getUserData() && (getUserData().role == 'superadmin' || getUserData().role == 'admin' || getUserData().role == 'tesorero'))
      );
    }
    
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && ('roles' in getUserData());
    }
    
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && ('roles' in getUserData());
    }
    
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && ('roles' in getUserData());
    }

    // -- MAIL (SISTEMA DE NOTIFICACIONES EXTENSION) --
    match /mail/{mailId} {
      // Cualquier usuario autenticado puede desencadenar un envío de correo (ej. recibo de pago o notificación)
      allow create: if isAuthenticated();
      allow read, update, delete: if false; // Solo el backend/extension de Firebase puede leer y modificar la cola
    }
    
    // -- COURSES --
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }
    
    // -- SETTINGS --
    match /settings/{settingId} {
      allow read: if settingId == 'version' || isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }
    
  }
}
